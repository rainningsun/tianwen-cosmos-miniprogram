<view
  class="lecture-card"
  hover-class="lecture-card--pressed"
  hover-stay-time="60"
  bindtap="onTap"
  aria-role="button"
  aria-label="{{lecture.title}}">
  <view class="lecture-card__visual">
    <image
      wx:if="{{lecture.cover}}"
      class="lecture-card__cover"
      src="{{lecture.cover}}"
      mode="aspectFill"
      lazy-load
    />
    <view wx:else class="lecture-card__placeholder">
      <text class="lecture-card__orbit">✦</text>
      <text class="lecture-card__ordinal">{{lecture.orderLabel}}</text>
    </view>
    <view wx:if="{{lecture.date}}" class="lecture-card__date">{{lecture.date}}</view>
  </view>

  <view class="lecture-card__body">
    <text class="lecture-card__kicker">{{lecture.orderLabel + (lecture.titleNote ? ' · ' + lecture.titleNote : '')}}</text>
    <text class="lecture-card__title">{{lecture.title}}</text>
    <text wx:if="{{lecture.summary}}" class="lecture-card__summary">{{lecture.summary}}</text>

    <view wx:if="{{lecture.keywords && lecture.keywords.length}}" class="lecture-card__keywords">
      <text wx:for="{{lecture.keywords}}" wx:key="*this" class="lecture-card__keyword">{{item}}</text>
    </view>

    <view class="lecture-card__cta">
      <text>进入本讲</text>
      <text class="lecture-card__arrow">→</text>
    </view>
  </view>
</view>
