<view class="page-shell assignment">
  <view class="shell-head">
    <text class="eyebrow">ASSIGNMENT</text>
    <text class="shell-title">我眼中的宇宙之美</text>
    <text class="shell-desc">期末作业说明 · 来源 {{assignment.source}}</text>
  </view>

  <view class="assignment-theme">
    <text class="assignment-theme__label">课件原文</text>
    <text class="assignment-theme__text">“{{assignment.theme}}”</text>
    <text class="assignment-theme__source">{{assignment.source}}</text>
  </view>

  <view class="assignment-section-head">
    <text class="assignment-section-head__kicker">FORMS</text>
    <text class="assignment-section-head__title">表现形式</text>
  </view>
  <text class="assignment-intro">{{assignment.intro}}</text>

  <view class="form-list">
    <view wx:for="{{assignment.forms}}" wx:key="id" class="form-row">
      <text class="form-row__index">{{index + 1}}</text>
      <view class="form-row__body">
        <text class="form-row__label">{{item.label}}</text>
        <text class="form-row__detail">{{item.detail}}</text>
      </view>
    </view>
  </view>

  <view class="progress-card">
    <view class="progress-card__top">
      <text class="progress-card__title">灵感清单</text>
      <text class="progress-card__count">{{checkedCount}} / {{totalCount}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-bar__fill" style="width: {{progress}}%"></view>
    </view>
    <text class="progress-card__note">勾选会保存在本机，仅作个人草稿，不改变作业要求。</text>
  </view>

  <view class="assignment-section-head">
    <text class="assignment-section-head__kicker">PROMPTS</text>
    <text class="assignment-section-head__title">参考选题</text>
  </view>

  <view wx:for="{{categories}}" wx:for-item="category" wx:key="id" class="category">
    <view class="category__head">
      <text class="category__index">{{category.index}}</text>
      <text class="category__title">{{category.title}}</text>
    </view>

    <view
      wx:for="{{category.items}}"
      wx:for-item="topic"
      wx:key="id"
      class="check-row {{topic.checked ? 'check-row--checked' : ''}}"
      data-id="{{topic.id}}"
      bindtap="toggleItem"
      aria-role="checkbox"
      aria-checked="{{topic.checked}}"
      aria-label="{{topic.text}}"
    >
      <view class="check-box">{{topic.checked ? '✓' : ''}}</view>
      <text class="check-text">{{topic.text}}</text>
    </view>

    <text wx:if="{{category.originalNote}}" class="category__note">{{category.originalNote}}</text>
  </view>

  <view class="assignment-footnote">
    <text class="assignment-footnote__text">{{assignment.footnote}}</text>
  </view>

  <view
    class="clear-button"
    bindtap="clearAll"
    hover-class="clear-button--pressed"
    aria-role="button"
    aria-label="清空勾选进度"
  >
    清空勾选进度
  </view>

  <text class="copyright">课件图片版权归授课教师及原作者所有，仅用于课程学习与展示。</text>
</view>
