.shell-head {
  padding-top: 96rpx;
}

.assignment-theme {
  margin-top: 46rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, rgba(216, 168, 78, 0.09), rgba(11, 15, 25, 0.72));
}

.assignment-theme__label {
  display: block;
  color: var(--color-gold);
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.assignment-theme__text {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-serif);
  font-size: 31rpx;
  line-height: 1.9;
}

.assignment-theme__source {
  display: block;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  text-align: right;
}

.assignment-section-head {
  margin-top: 58rpx;
  margin-bottom: 14rpx;
}

.assignment-section-head__kicker {
  display: block;
  color: var(--color-gold);
  font-size: 21rpx;
  letter-spacing: 5rpx;
}

.assignment-section-head__title {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-serif);
  font-size: 38rpx;
}

.assignment-intro {
  display: block;
  color: var(--color-ink-dim);
  font-size: 27rpx;
  line-height: 1.85;
}

.form-list {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--color-line-cool);
}

.form-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.form-row__index {
  flex: none;
  width: 52rpx;
  color: var(--color-gold);
  font-family: var(--font-serif);
  font-size: 24rpx;
}

.form-row__body {
  flex: 1;
}

.form-row__label {
  display: block;
  font-family: var(--font-serif);
  font-size: 30rpx;
}

.form-row__detail {
  display: block;
  margin-top: 2rpx;
  color: var(--color-ink-dim);
  font-size: 25rpx;
  line-height: 1.8;
}

.progress-card {
  margin-top: 44rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--color-line-cool);
  border-radius: var(--radius-card);
  background: rgba(11, 15, 25, 0.62);
}

.progress-card__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.progress-card__title {
  font-family: var(--font-serif);
  font-size: 30rpx;
}

.progress-card__count {
  color: var(--color-gold);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.progress-bar {
  height: 6rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(139, 147, 167, 0.18);
}

.progress-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-gold), #f0d08f);
  transition: width 200ms ease;
}

.progress-card__note {
  display: block;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.7;
}

.category {
  margin-top: 34rpx;
}

.category__head {
  display: flex;
  align-items: baseline;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.category__index {
  margin-right: 14rpx;
  color: var(--color-gold);
  font-family: var(--font-serif);
  font-size: 24rpx;
}

.category__title {
  font-family: var(--font-serif);
  font-size: 33rpx;
}

.check-row {
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.check-row--checked {
  background: linear-gradient(90deg, rgba(216, 168, 78, 0.08), transparent 80%);
}

.check-box {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin: 6rpx 18rpx 0 0;
  border: 1rpx solid rgba(139, 147, 167, 0.6);
  border-radius: 4rpx;
  color: var(--color-bg);
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.check-row--checked .check-box {
  border-color: var(--color-gold);
  background: var(--color-gold);
}

.check-text {
  flex: 1;
  color: var(--color-ink-dim);
  font-size: 26rpx;
  line-height: 1.75;
}

.check-row--checked .check-text {
  color: var(--color-ink);
}

.category__note {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.7;
}

.assignment-footnote {
  margin-top: 46rpx;
  padding: 26rpx 28rpx;
  border-left: 2rpx solid var(--color-cyan);
  background: linear-gradient(90deg, rgba(101, 200, 208, 0.07), transparent 82%);
}

.assignment-footnote__text {
  font-family: var(--font-serif);
  font-size: 28rpx;
  line-height: 1.9;
}

.clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 36rpx;
  border: 1rpx solid var(--color-line-cool);
  border-radius: var(--radius-card);
  color: var(--color-muted);
  font-size: 24rpx;
}

.clear-button--pressed {
  background: rgba(139, 147, 167, 0.12);
}

.copyright {
  margin-top: 60rpx;
}
