.shell-head {
  padding-top: 96rpx;
}

.topic-tabs {
  margin: 42rpx -40rpx 0;
  padding: 0 40rpx;
  white-space: nowrap;
}

.topic-tabs__inner {
  display: inline-flex;
  padding-bottom: 8rpx;
}

.topic-tab {
  flex: none;
  margin-right: 12rpx;
  padding: 14rpx 22rpx;
  border: 1rpx solid var(--color-line-cool);
  border-radius: 999rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.topic-tab--active {
  border-color: var(--color-gold);
  background: rgba(216, 168, 78, 0.12);
  color: var(--color-gold);
}

.topic-article {
  padding-top: 46rpx;
}

.topic-article__en {
  display: block;
  color: var(--color-gold);
  font-size: 21rpx;
  letter-spacing: 5rpx;
}

.topic-article__title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-serif);
  font-size: 52rpx;
  line-height: 1.42;
}

.topic-article__lede {
  display: block;
  margin-top: 20rpx;
  color: var(--color-ink-dim);
  font-size: 28rpx;
  line-height: 1.9;
}

.triad {
  margin-top: 38rpx;
  border-top: 1rpx solid var(--color-line-cool);
}

.triad__node {
  position: relative;
  padding: 26rpx 0 26rpx 58rpx;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.triad__node::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 42rpx;
  width: 20rpx;
  height: 20rpx;
  border: 1rpx solid var(--color-gold);
  border-radius: 50%;
  background: var(--color-bg);
}

.triad__node::after {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 62rpx;
  bottom: -26rpx;
  width: 1rpx;
  background: var(--color-line);
}

.triad__node:last-child::after {
  display: none;
}

.triad__index {
  color: var(--color-gold);
  font-family: var(--font-serif);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.triad__label {
  display: block;
  margin-top: 2rpx;
  font-family: var(--font-serif);
  font-size: 34rpx;
}

.triad__text {
  display: block;
  margin-top: 6rpx;
  color: var(--color-ink-dim);
  font-size: 26rpx;
  line-height: 1.85;
}

.triad__source {
  display: block;
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.ladder {
  margin-top: 38rpx;
  padding-left: 10rpx;
}

.ladder__step {
  display: flex;
  align-items: flex-start;
  padding: 0 0 26rpx 22rpx;
  border-left: 1rpx solid var(--color-line);
}

.ladder__step:last-child {
  border-left-color: transparent;
}

.ladder__mark {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-left: -46rpx;
  margin-right: 20rpx;
  border: 1rpx solid var(--color-gold);
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-gold);
  font-family: var(--font-serif);
  font-size: 23rpx;
  line-height: 46rpx;
  text-align: center;
}

.ladder__body {
  flex: 1;
  padding-top: 2rpx;
}

.ladder__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
}

.ladder__text {
  display: block;
  margin-top: 4rpx;
  color: var(--color-ink-dim);
  font-size: 25rpx;
  line-height: 1.8;
}

.ladder__source {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.topic-timeline {
  margin-top: 38rpx;
}

.topic-timeline__item {
  position: relative;
  padding: 0 0 30rpx 38rpx;
}

.topic-timeline__item::before {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 12rpx;
  bottom: -8rpx;
  width: 1rpx;
  background: var(--color-line);
}

.topic-timeline__item:last-child::before {
  display: none;
}

.topic-timeline__dot {
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: var(--color-gold);
}

.topic-timeline__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
}

.topic-timeline__text {
  display: block;
  margin-top: 4rpx;
  color: var(--color-ink-dim);
  font-size: 25rpx;
  line-height: 1.8;
}

.topic-timeline__source {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.editorial {
  position: relative;
  margin-top: 44rpx;
  padding: 40rpx 0 34rpx;
  border-top: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
}

.editorial__mark {
  position: absolute;
  top: 16rpx;
  left: -8rpx;
  color: rgba(216, 168, 78, 0.35);
  font-family: var(--font-serif);
  font-size: 90rpx;
  line-height: 1;
}

.editorial__quote {
  display: block;
  padding-left: 34rpx;
  font-family: var(--font-serif);
  font-size: 46rpx;
  line-height: 1.65;
}

.editorial__source {
  display: block;
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-align: right;
}

.pause {
  margin-top: 48rpx;
  padding: 80rpx 0 64rpx;
  border-top: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
  text-align: center;
}

.pause__question {
  display: block;
  color: var(--color-ink);
  font-family: var(--font-serif);
  font-size: 76rpx;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.pause__sub {
  display: block;
  margin-top: 26rpx;
  color: var(--color-gold);
  font-size: 26rpx;
  letter-spacing: 3rpx;
}

.pause__source {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.topic-thesis {
  margin-top: 40rpx;
  padding: 28rpx 28rpx 24rpx;
  border-left: 2rpx solid var(--color-cyan);
  background: linear-gradient(90deg, rgba(101, 200, 208, 0.07), transparent 82%);
}

.topic-thesis__label {
  display: block;
  color: var(--color-cyan);
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

.topic-thesis__text {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-serif);
  font-size: 30rpx;
  line-height: 1.85;
}

.topic-thesis__source {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.topic-sections {
  margin-top: 18rpx;
}

.topic-section {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.topic-section__title {
  display: block;
  font-family: var(--font-serif);
  font-size: 33rpx;
}

.topic-section__text {
  display: block;
  margin-top: 10rpx;
  color: var(--color-ink-dim);
  font-size: 27rpx;
  line-height: 1.9;
}

.topic-section__source {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.related {
  margin-top: 48rpx;
  border-top: 1rpx solid var(--color-line-cool);
}

.related__kicker {
  display: block;
  padding-top: 22rpx;
  color: var(--color-gold);
  font-size: 21rpx;
  letter-spacing: 4rpx;
}

.related-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.related-row--pressed {
  opacity: 0.7;
}

.related-row__title {
  display: block;
  font-family: var(--font-serif);
  font-size: 29rpx;
  line-height: 1.5;
}

.related-row__note {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.related-row__arrow {
  color: var(--color-gold);
  font-size: 30rpx;
}
