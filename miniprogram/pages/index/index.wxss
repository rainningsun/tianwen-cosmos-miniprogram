.home {
  overflow: hidden;
}

.home__inner {
  position: relative;
  z-index: 1;
}

.starfield {
  position: fixed;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background:
    radial-gradient(circle at 78% 4%, rgba(101, 200, 208, 0.08), transparent 26%),
    radial-gradient(circle at 12% 30%, rgba(216, 168, 78, 0.06), transparent 30%),
    #05070d;
}

.starfield::before,
.starfield::after {
  content: "";
  position: absolute;
  width: 2rpx;
  height: 2rpx;
  border-radius: 50%;
  background: transparent;
}

.starfield::before {
  top: 16%;
  left: 18%;
  box-shadow:
    44rpx 60rpx 0 rgba(242, 237, 227, 0.68),
    190rpx 22rpx 0 rgba(242, 237, 227, 0.45),
    330rpx 140rpx 0 rgba(216, 168, 78, 0.6),
    470rpx 48rpx 0 rgba(242, 237, 227, 0.36),
    600rpx 196rpx 0 rgba(101, 200, 208, 0.55),
    84rpx 300rpx 0 rgba(242, 237, 227, 0.4),
    268rpx 372rpx 0 rgba(216, 168, 78, 0.45),
    412rpx 286rpx 0 rgba(242, 237, 227, 0.3),
    556rpx 420rpx 0 rgba(242, 237, 227, 0.52),
    660rpx 340rpx 0 rgba(101, 200, 208, 0.38),
    120rpx 540rpx 0 rgba(242, 237, 227, 0.34),
    248rpx 620rpx 0 rgba(216, 168, 78, 0.42),
    388rpx 566rpx 0 rgba(242, 237, 227, 0.26),
    520rpx 660rpx 0 rgba(101, 200, 208, 0.34),
    684rpx 588rpx 0 rgba(242, 237, 227, 0.48),
    54rpx 760rpx 0 rgba(242, 237, 227, 0.28),
    210rpx 840rpx 0 rgba(216, 168, 78, 0.32),
    360rpx 790rpx 0 rgba(242, 237, 227, 0.42),
    512rpx 884rpx 0 rgba(242, 237, 227, 0.3),
    650rpx 820rpx 0 rgba(101, 200, 208, 0.3),
    88rpx 1010rpx 0 rgba(242, 237, 227, 0.36),
    286rpx 960rpx 0 rgba(242, 237, 227, 0.26),
    430rpx 1080rpx 0 rgba(216, 168, 78, 0.30),
    590rpx 990rpx 0 rgba(242, 237, 227, 0.4),
    700rpx 1120rpx 0 rgba(101, 200, 208, 0.26);
  opacity: 0.72;
}

.starfield::after {
  top: 6%;
  left: 32%;
  box-shadow:
    60rpx 180rpx 0 rgba(242, 237, 227, 0.3),
    240rpx 90rpx 0 rgba(101, 200, 208, 0.28),
    400rpx 230rpx 0 rgba(242, 237, 227, 0.34),
    558rpx 120rpx 0 rgba(216, 168, 78, 0.28),
    108rpx 440rpx 0 rgba(242, 237, 227, 0.32),
    300rpx 500rpx 0 rgba(242, 237, 227, 0.24),
    470rpx 390rpx 0 rgba(101, 200, 208, 0.26),
    620rpx 520rpx 0 rgba(242, 237, 227, 0.3),
    160rpx 700rpx 0 rgba(216, 168, 78, 0.24),
    340rpx 680rpx 0 rgba(242, 237, 227, 0.28),
    520rpx 760rpx 0 rgba(242, 237, 227, 0.22),
    688rpx 700rpx 0 rgba(101, 200, 208, 0.22);
  opacity: 0.55;
}

.starfield--animated::before {
  animation: star-breathe 9s ease-in-out infinite alternate;
}

.starfield--animated::after {
  animation: star-drift 16s ease-in-out infinite alternate;
}

@keyframes star-breathe {
  from { opacity: 0.38; }
  to { opacity: 0.82; }
}

@keyframes star-drift {
  from { transform: translate3d(0, 0, 0); opacity: 0.34; }
  to { transform: translate3d(-14rpx, 18rpx, 0); opacity: 0.62; }
}

.home__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 28rpx;
}

.home__mark {
  color: var(--color-muted);
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.star-toggle {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 4rpx 0 20rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.star-toggle--pressed {
  opacity: 0.7;
}

.star-toggle__dot {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(139, 147, 167, 0.55);
  border-radius: 50%;
  background: transparent;
}

.star-toggle__dot--on {
  border-color: var(--color-gold);
  background: radial-gradient(circle at 40% 38%, #f7dfad, var(--color-gold) 58%, #7b5a26);
  box-shadow: 0 0 18rpx rgba(216, 168, 78, 0.45);
}

.hero {
  padding-top: 54rpx;
}

.hero__title {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-top: 24rpx;
  font-family: var(--font-serif);
  font-size: 76rpx;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.hero__colon {
  color: var(--color-gold);
}

.hero__lecturer {
  display: block;
  margin-top: 20rpx;
  color: var(--color-ink-dim);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.hero__mission {
  display: block;
  margin-top: 30rpx;
  max-width: 640rpx;
  color: var(--color-ink-dim);
  font-size: 28rpx;
  line-height: 1.9;
}

.count-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 52rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line-cool);
}

.count-line__num {
  margin-right: 10rpx;
  color: var(--color-gold);
  font-family: var(--font-serif);
  font-size: 52rpx;
  line-height: 1;
}

.count-line__label {
  color: var(--color-ink);
  font-size: 26rpx;
}

.count-line__next {
  margin-left: auto;
  color: var(--color-muted);
  font-size: 22rpx;
}

.timeline {
  position: relative;
  padding-left: 34rpx;
}

.timeline__rail {
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 8rpx;
  width: 1rpx;
  background: linear-gradient(180deg, rgba(216, 168, 78, 0.45), rgba(139, 147, 167, 0.12));
}

.timeline__item {
  position: relative;
  margin-bottom: 30rpx;
}

.timeline__node {
  position: absolute;
  top: 30rpx;
  left: -32rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: var(--color-gold);
  box-shadow: 0 0 14rpx rgba(216, 168, 78, 0.55);
}

.timeline__node--hollow {
  background: var(--color-bg);
  border: 1rpx solid var(--color-muted);
  box-shadow: none;
}

.thread-list {
  border-top: 1rpx solid var(--color-line-cool);
}

.thread-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 20rpx 6rpx;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.thread-item--pressed {
  opacity: 0.72;
}

.thread-item__text {
  display: flex;
  flex-direction: column;
}

.thread-item__title {
  font-family: var(--font-serif);
  font-size: 32rpx;
}

.thread-item__note {
  margin-top: 2rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.thread-item__arrow {
  color: var(--color-gold);
  font-size: 30rpx;
}

