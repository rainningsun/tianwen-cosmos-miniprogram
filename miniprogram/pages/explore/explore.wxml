<view class="page-shell">
  <view class="ref-hero">
    <text class="eyebrow">EXPLORE</text>
    <text class="shell-title">探索</text>
    <text class="shell-desc">从尺度、时间与未知三个方向，继续追问。</text>

    <view class="explore-grid">
      <view
        wx:for="{{cards}}"
        wx:key="id"
        class="explore-card {{item.href ? 'explore-card--active' : ''}}"
        data-href="{{item.href}}"
        bindtap="openCard"
        aria-role="button"
        aria-label="打开{{item.title}}"
        aria-disabled="{{!item.href}}"
      >
        <view class="explore-card__top">
          <text class="explore-card__index">{{item.index}}</text>
          <text class="source">{{item.meta}}</text>
        </view>
        <text class="explore-card__title">{{item.title}}</text>
        <text class="explore-card__question">{{item.question}}</text>
        <view class="explore-card__meta">
          <text>{{item.href ? '进入' : '整理中'}}</text>
          <text wx:if="{{item.href}}" class="explore-card__arrow">→</text>
        </view>
      </view>
    </view>

    <text class="copyright">探索页只做索引与尺度示意；数字与结论仍回到课件页码。</text>
  </view>
</view>
