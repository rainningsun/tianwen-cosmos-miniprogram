<view class="page-shell">
  <view class="shell-head">
    <text class="eyebrow">ARCHIVE</text>
    <text class="shell-title">课件原页</text>
    <text class="shell-desc">只收录每讲的关键页，按 PDF 阅读器页码标注。点击讲次进入对应的原页区域。</text>
  </view>

  <view wx:if="{{lectures.length}}" class="archive-list">
    <view
      wx:for="{{lectures}}"
      wx:key="id"
      class="archive-row {{item.status === 'upcoming' ? 'archive-row--upcoming' : ''}}"
      data-id="{{item.id}}"
      data-page-path="{{item.pagePath}}"
      bindtap="openLecture"
      hover-class="{{item.status === 'published' ? 'archive-row--pressed' : 'none'}}"
      aria-role="button"
      aria-label="{{item.status === 'published' ? '查看第 ' + item.order + ' 讲课件原页' : item.orderLabel + '待更新，暂无原页'}}"
      aria-disabled="{{item.status !== 'published'}}"
    >
      <view class="archive-row__body">
        <text class="archive-row__title">{{item.orderLabel}} · {{item.status === 'upcoming' ? '待更新' : item.title}}</text>
        <text wx:if="{{item.status === 'published'}}" class="archive-row__meta">{{item.date}} · 收录 {{item.count}} 页</text>
        <text wx:else class="archive-row__meta">课件尚未提供 · 暂未收录</text>
      </view>
      <view class="archive-row__action">
        <text class="archive-row__label">{{item.status === 'published' ? '原页' : '待更新'}}</text>
        <text wx:if="{{item.status === 'published'}}" class="archive-row__arrow">→</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-panel">
    <text class="empty-panel__title">原页索引正在建立</text>
    <text class="empty-panel__note">每讲将选取 6-10 张关键页，并附页码与客观图注。</text>
  </view>

  <text class="copyright">课件图片版权归授课教师及原作者所有，仅用于课程学习与展示。</text>
</view>
