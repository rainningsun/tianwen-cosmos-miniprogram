.explore-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
  margin-top: 36rpx;
}

.explore-card {
  display: block;
  padding: 30rpx;
  border: 1rpx solid var(--color-line-cool);
  border-radius: var(--radius-card);
  background: linear-gradient(150deg, rgba(16, 22, 35, 0.85), rgba(8, 11, 18, 0.92));
}

.explore-card--active {
  border-color: var(--color-line);
}

.explore-card__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.explore-card__index {
  color: var(--color-gold);
  font-family: var(--font-mono);
  font-size: 22rpx;
}

.explore-card__title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-serif);
  font-size: 38rpx;
  line-height: 1.4;
}

.explore-card__question {
  display: block;
  margin-top: 12rpx;
  color: var(--color-ink-dim);
  font-size: 26rpx;
  line-height: 1.8;
}

.explore-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-line-cool);
  color: var(--color-muted);
  font-size: 22rpx;
}

.explore-card__arrow {
  color: var(--color-gold);
  font-size: 30rpx;
}

.scale-shell {
  padding-top: 46rpx;
}

.scale-note {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-left: 2rpx solid var(--color-cyan);
  background: linear-gradient(90deg, rgba(101, 200, 208, 0.07), transparent 82%);
  color: var(--color-ink-dim);
  font-size: 23rpx;
  line-height: 1.8;
}

.scale-current {
  margin-top: 30rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: linear-gradient(145deg, rgba(216, 168, 78, 0.08), rgba(11, 15, 25, 0.85));
}

.scale-current__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.scale-current__count {
  color: var(--color-gold);
  font-family: var(--font-mono);
  font-size: 22rpx;
}

.scale-current__title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-serif);
  font-size: 46rpx;
  line-height: 1.3;
}

.scale-current__distance {
  display: block;
  margin-top: 8rpx;
  color: var(--color-gold);
  font-family: var(--font-serif);
  font-size: 32rpx;
}

.scale-current__method {
  display: block;
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.scale-current__desc {
  display: block;
  margin-top: 16rpx;
  color: var(--color-ink-dim);
  font-size: 26rpx;
  line-height: 1.85;
}

.source-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  color: var(--color-gold);
  font-size: 19rpx;
}

.source-badge--supplement {
  border-color: rgba(101, 200, 208, 0.45);
  color: var(--color-cyan);
}

.scale-slider {
  margin: 36rpx 10rpx 0;
}

.scale-range {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 19rpx;
}

.scale-nav {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.scale-nav__button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid var(--color-line-cool);
  border-radius: 999rpx;
  color: var(--color-ink-dim);
  font-size: 23rpx;
}

.scale-nav__button--disabled {
  opacity: 0.4;
}

.scale-stages {
  margin-top: 32rpx;
  border-top: 1rpx solid var(--color-line-cool);
}

.scale-stage {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 76rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-line-cool);
}

.scale-stage--active {
  color: var(--color-gold);
}

.scale-stage__title {
  font-family: var(--font-serif);
  font-size: 27rpx;
}

.scale-stage__label {
  color: var(--color-muted);
  font-family: var(--font-mono);
  font-size: 20rpx;
  text-align: right;
}

.scale-related {
  margin-top: 34rpx;
}

.scale-related__title {
  display: block;
  color: var(--color-muted);
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

@media (min-width: 700px) {
  .explore-grid {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
